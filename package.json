{
  "name": "pm-admin",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Админка по управлению продуктом (pm-admin)",
  "scripts": {
    "dev": "webpack serve",
    "build": "node scripts/type-check.mjs && webpack --mode production",
    "preview": "npx http-server dist",
    "mcp:obsidian": "node scripts/obsidian-mcp.mjs",
    "set-registry": "npm set registry https://verdaccio.tirscript.com/",
    "lint": "eslint . --ext .vue,.js,.ts",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "type-check": "node scripts/type-check.mjs",
    "type-check:full": "vue-tsc --noEmit"
  },
  "dependencies": {
    "js-cookie": "^3.0.5",
    "tir-components": "^1.0.150",
    "tir-pm-toolkit": "^1.0.11",
    "tir-style-system": "^1.1.8",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.27.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.10.2",
    "@types/webpack": "^5.28.5",
    "@types/webpack-dev-server": "^4.7.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.0",
    "esbuild-loader": "^4.4.3",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^16.2.0",
    "html-webpack-plugin": "^5.6.7",
    "prettier": "^3.3.0",
    "process": "^0.11.10",
    "sass": "^1.83.0",
    "sass-loader": "^14.2.1",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "vue-tsc": "^2.2.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  }
}
